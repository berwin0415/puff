{
  "name": "@puff/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "puff web client (React + Rsbuild)",
  "scripts": {
    "dev": "rsbuild",
    "build": "tsc --noEmit && rsbuild build",
    "preview": "rsbuild preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "rimraf dist node_modules/.cache"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@rsbuild/core": "catalog:",
    "@rsbuild/plugin-react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  }
}
