FROM python:3.12.13-slim-bookworm@sha256:3f9c7f75b916e8279e24136d7a57769aba9e193715be52570417698c52d6eed0
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY compose/locks/runtime-requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt
COPY fixtures /app/fixtures
COPY execution /app/execution
COPY runner /app/runner
COPY configs /app/configs
COPY adapters/deepagents_langgraph/pause_recovery.py /app/adapters/deepagents_langgraph/pause_recovery.py
ENTRYPOINT ["python"]
