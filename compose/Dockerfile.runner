FROM python:3.12-slim

WORKDIR /app
COPY runner /app/runner
COPY contracts /app/contracts
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app
# M1 placeholder: the real Runner is supplied by runner/ without changing the
# Compose topology.  An HTTP server keeps the service alive for dependency and
# restart tests while candidate adapters are being integrated.
CMD ["python", "-m", "http.server", "8081", "--directory", "/app"]
