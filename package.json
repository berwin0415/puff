{
  "name": "puff",
  "version": "0.0.0",
  "private": true,
  "description": "puff monorepo: NestJS API + React web",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "dev:api": "pnpm --filter @puff/api run dev",
    "dev:web": "pnpm --filter @puff/web run dev",
    "build": "pnpm -r run build",
    "start:api": "pnpm --filter @puff/api run start:prod",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "rimraf": "^6.1.3"
  }
}
