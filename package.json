{
  "name": "puff",
  "version": "0.0.0",
  "private": true,
  "description": "puff monorepo: NestJS API + React web + DSH desktop client",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @puff/api run dev",
    "dev:web": "pnpm --filter @puff/web run dev",
    "dev:desktop": "pnpm --filter @puff/desktop run dev",
    "build": "pnpm -r run build",
    "start:api": "pnpm --filter @puff/api run start:prod",
    "package:desktop:win": "pnpm --filter @puff/desktop run package:win",
    "check": "biome check .",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "nx": "catalog:",
    "rimraf": "catalog:"
  }
}
