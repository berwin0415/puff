#!/bin/sh
# 首次本地初始化：安装固定工具链，再安装 workspace 依赖。
set -eu

cd "$(dirname "$0")/.."

if command -v mise >/dev/null 2>&1; then
  mise install
  mise exec -- pnpm install
else
  echo "mise not found; using the Node/pnpm on PATH." >&2
  pnpm install
fi

echo "Ready. Try 'pnpm -r --parallel run dev', 'pnpm exec nx graph' or 'node tools/checks/project-boundaries.mjs'."
