{
  "name": "@puff/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "puff desktop client (Electron + DeepSeek Harness)",
  "author": "puff",
  "license": "UNLICENSED",
  "main": "dist/main.mjs",
  "scripts": {
    "dev": "node scripts/copy-static.mjs && tsdown && concurrently -k \"tsdown --watch\" \"electronmon .\"",
    "start": "electron .",
    "build": "tsc --noEmit && tsdown && node scripts/copy-static.mjs",
    "package:win": "pnpm run build && node scripts/package-win.mjs nsis",
    "package:win:dir": "pnpm run build && node scripts/package-win.mjs dir",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "clean": "rimraf dist release/desktop release/app release/runtime node_modules/.cache"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "pnpm": "11.7.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "concurrently": "10.0.5",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electronmon": "2.0.4",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
