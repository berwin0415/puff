{
  "name": "@puff/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "puff web client (React + Rsbuild)",
  "scripts": {
    "dev": "rsbuild",
    "build": "tsc --noEmit && rsbuild build",
    "preview": "rsbuild preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "rimraf dist node_modules/.cache"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.10",
    "@rsbuild/plugin-react": "^2.1.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
