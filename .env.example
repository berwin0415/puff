# Remote model API. Keep actual credentials in an untracked .env file or shell.
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# Keep raw runs outside the Git worktree.
HARNESS_LAB_ARTIFACT_ROOT=~/harness-lab-data/runs

# Local state defaults used by the MVP runner.
HARNESS_LAB_STATE_DB=var/state/harness.db
HARNESS_LAB_EVENT_ROOT=var/events
